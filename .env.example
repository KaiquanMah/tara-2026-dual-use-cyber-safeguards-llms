# TARA Pipeline — Environment Variables
# Copy this file to .env and fill in your keys.
#   cp .env.example .env
# The pipeline reads keys directly from environment variables (not from .env),
# but tools like direnv or `export $(grep -v '^#' .env | xargs)` can load them.

# --- OpenRouter (tracks: openrouter-claude, openrouter-gpt, test-openrouter-deepseek, test-openrouter-kimi) ---
# For Kai and Jose's OpenRouter-based tracks.
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Anthropic Direct (track: cvp-claude) ---
# For Samuel's CVP Claude access via direct Anthropic API.
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- OpenAI Direct (track: tac-gpt) ---
# For Jose's TAC GPT access via direct OpenAI API.
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY_TAC=
